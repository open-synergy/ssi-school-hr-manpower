<odoo>

    <template
        id="manpower_planning_summary_content_school"
        inherit_id="ssi_hr_manpower_planning.manpower_planning_summary_content"
    >
        <xpath expr="//div[@class='page']/div[2]" position="after">
            <t t-if="doc['school_recap']">
                <h5 class="mt-3">School Recap</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>School</th>
                            <th>Academic Year</th>
                            <th>Category</th>
                            <th class="text-right">Needed</th>
                            <th class="text-right">Filled</th>
                            <th class="text-right">Vacant</th>
                            <th class="text-right">Filled (%)</th>
                            <th class="text-right">Vacant (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc['school_recap']" t-as="recap">
                            <td>
                                <t t-esc="recap['school'].name" />
                            </td>
                            <td>
                                <t t-esc="recap['academic_year'].name" />
                            </td>
                            <td>
                                <t t-esc="recap['category']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="recap['quantity_needed']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="recap['quantity_filled']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="recap['quantity_vacant']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % recap['percent_filled']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % recap['percent_vacant']" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
        <xpath expr="//h5[normalize-space(.)='Contract Review']" position="before">
            <t t-if="doc['teaching_lines']">
                <h5 class="mt-3">Teaching</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Grade</th>
                            <th>Classes</th>
                            <th class="text-right">Weekly Hours per Class</th>
                            <th class="text-right">Total Classes</th>
                            <th class="text-right">Total Weekly Hours</th>
                            <th>Teacher</th>
                            <th>Co-Teacher</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc['teaching_lines']" t-as="line">
                            <td>
                                <t t-esc="line['subject'].name" />
                            </td>
                            <td>
                                <t t-esc="line['grade'].name" />
                            </td>
                            <td>
                                <t t-esc="line['classes']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['total_class']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['total_weekly_hours']" />
                            </td>
                            <td>
                                <t t-if="line['teacher']">
                                    <t t-esc="line['teacher'].name" />
                                </t>
                                <t t-else="">Vacant</t>
                            </td>
                            <td>
                                <t t-esc="line['co_teacher'].name" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="doc['assignment_lines']">
                <h5 class="mt-3">Additional Assignments</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Assignment Type</th>
                            <th>Category</th>
                            <th>Hour Basis</th>
                            <th>Employee</th>
                            <th class="text-right">Hours</th>
                            <th class="text-right">Number of Classes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc['assignment_lines']" t-as="line">
                            <td>
                                <t t-esc="line['type'].name" />
                            </td>
                            <td>
                                <t t-esc="line['category']" />
                            </td>
                            <td>
                                <t t-esc="line['hour_basis']" />
                            </td>
                            <td>
                                <t t-if="line['employee']">
                                    <t t-esc="line['employee'].name" />
                                </t>
                                <t t-else="">Vacant</t>
                            </td>
                            <td class="text-right">
                                <t t-esc="line['hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['class_count']" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="doc['workload_lines']">
                <h5 class="mt-3">Workload</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th class="text-right">Teaching Hours</th>
                            <th class="text-right">Co-Teaching Hours</th>
                            <th class="text-right">Assignment Hours per Week</th>
                            <th class="text-right">Picket Hours per Week</th>
                            <th class="text-right">Total Weekly Hours</th>
                            <th class="text-right">Mandatory Weekly Hours</th>
                            <th class="text-right">Lacking Weekly Hours</th>
                            <th class="text-right">Excess Weekly Hours</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc['workload_lines']" t-as="line">
                            <td>
                                <t t-esc="line['employee_label']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['teaching_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % line['co_teaching_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['assignment_weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['picket_weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % line['total_weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="line['mandatory_weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % line['lack_weekly_hours']" />
                            </td>
                            <td class="text-right">
                                <t t-esc="'%.2f' % line['excess_weekly_hours']" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>

</odoo>
