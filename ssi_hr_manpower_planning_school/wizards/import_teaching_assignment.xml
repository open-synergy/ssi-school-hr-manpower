<odoo>
<record id="import_teaching_assignment_view_form" model="ir.ui.view">
    <field name="name">import_teaching_assignment - form</field>
    <field name="model">import_teaching_assignment</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field
                        name="planning_id"
                        readonly="1"
                        force_save="1"
                        options="{'no_open': True, 'no_create': True}"
                    />
                <field name="academic_year_id" invisible="1" />
                <field name="allowed_academic_term_ids" invisible="1" />
                <field
                        name="academic_term_id"
                        options="{'no_create': True}"
                        domain="[('id', 'in', allowed_academic_term_ids)]"
                    />
            </group>
            <footer>
                <button
                        name="action_confirm"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>
</odoo>
